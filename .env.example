# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API).

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-anon-key

# Secret key: server-only, never expose it to the browser. Needed for "delete my account".
SUPABASE_SECRET_KEY=your-secret-or-service-role-key

# Where the site runs; used to build links in auth emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
